# All optional. GOLT works with zero keys (public tile + routing endpoints below are demo-grade).
# Tile layer; {s}{z}{x}{y}{r} placeholders. Use your own provider key for production traffic.
# Default is OpenStreetMap standard tiles (demo-grade; dark theme via CSS filter).
# For real traffic use a keyed provider, e.g. MapTiler:
# VITE_TILE_URL_DARK=https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_URL_LIGHT=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# Routing (OSRM-compatible). Leave empty to use the offline road-like fallback only.
VITE_OSRM_URL=https://router.project-osrm.org
